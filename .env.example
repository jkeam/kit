# Environment Variables
# Copy this to .env and fill in your values

# LLM Provider
# For LlamaStack/OGX (default):
LLM_BASE_URL=http://localhost:8321
LLM_MODEL=redhat-maas/qwen3-14b
# For Ollama:
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen3:14b

# Gateway (optional)
GATEWAY_TOKEN=your-secret-token-here

# Chat Platform Tokens (Phase 2)
# TELEGRAM_BOT_TOKEN=your-telegram-token
# DISCORD_BOT_TOKEN=your-discord-token

# Cloud LLM APIs (optional - for hybrid approach)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Web Search (Phase 4)
TAVILY_API_KEY=your-tavily-api-key-here  # Get from https://tavily.com
