# Environment Variables
# Copy this to .env and fill in your values

# LLM Provider
# LLM_PROVIDER selects the client used to talk to LLM_BASE_URL:
#   llamastack (default) - uses the LlamaStack client
#   ollama / openai       - uses a plain OpenAI-compatible client
#
# For LlamaStack/OGX (default):
LLM_PROVIDER=llamastack
LLM_BASE_URL=http://localhost:8321
LLM_MODEL=redhat-maas/qwen3-14b

# For Ollama (OpenAI-compatible endpoint):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:14b

# For OpenCode Zen (https://opencode.ai/zen - OpenAI-compatible):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_MODEL=<model-id-from-opencode-zen>
# LLM_API_KEY=your-opencode-zen-api-key
# LLM_EXTRA_HEADERS={"x-opencode-session": "your-session-id"}

# LLM_EXTRA_HEADERS (optional): JSON object of extra HTTP headers sent with
# every LLM request, for any provider.

# Gateway (optional)
GATEWAY_TOKEN=your-secret-token-here

# CORS origins allowed to call the gateway API, comma-separated.
# Defaults to "*" (all origins) for local/dev use — restrict this in production.
# CORS_ORIGINS=https://example.com,https://app.example.com

# Chat Platform Tokens (Phase 2)
# TELEGRAM_BOT_TOKEN=your-telegram-token
# DISCORD_BOT_TOKEN=your-discord-token

# Cloud LLM APIs (optional - for hybrid approach)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Web Search (Phase 4)
TAVILY_API_KEY=your-tavily-api-key-here  # Get from https://tavily.com
