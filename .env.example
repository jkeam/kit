# Environment Variables
# Copy this to .env and fill in your values

# LLM Provider
# LLM_PROVIDER selects the client used to talk to LLM_BASE_URL:
#   llamastack (default) - uses the LlamaStack client
#   ollama / openai       - uses a plain OpenAI-compatible client
#
# For LlamaStack/OGX (default):
LLM_PROVIDER=llamastack
LLM_BASE_URL=http://localhost:8321
LLM_MODEL=redhat-maas/qwen3-14b

# For Ollama (OpenAI-compatible endpoint):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:14b

# For OpenCode Zen (https://opencode.ai/zen - OpenAI-compatible):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_MODEL=<model-id-from-opencode-zen>
# LLM_API_KEY=your-opencode-zen-api-key
# LLM_EXTRA_HEADERS={"x-opencode-session": "your-session-id"}

# LLM_EXTRA_HEADERS (optional): JSON object of extra HTTP headers sent with
# every LLM request, for any provider.

# Gateway (optional). When set, all API routes and the /ws WebSocket require
# it as a bearer token (`Authorization: Bearer <token>`); the web UI will
# prompt for it once and remember it in the browser's localStorage. Unset
# (the default) leaves the gateway open, matching prior behavior.
GATEWAY_TOKEN=your-secret-token-here

# Host/port the gateway binds to (defaults shown). Set GATEWAY_TOKEN above
# before binding GATEWAY_HOST to 0.0.0.0 or any public interface.
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=18789

# CORS origins allowed to call the gateway API, comma-separated.
# Defaults to "*" (all origins) for local/dev use — restrict this in production.
# CORS_ORIGINS=https://example.com,https://app.example.com

# Max WebSocket reconnect attempts the web UI makes before giving up
# (served to the browser via GET /config). Default: 5.
# WS_MAX_RECONNECT_ATTEMPTS=5

# Context window protection. MAX_CONTEXT_TOKENS is the estimated token
# budget for the full LLM request — tool results are truncated (oldest
# first) when the payload exceeds it. MAX_TOOL_RESULT_CHARS caps a
# single tool result to prevent one huge response from filling the
# context. Tune MAX_CONTEXT_TOKENS to match your model's context limit.
# MAX_CONTEXT_TOKENS=120000
# MAX_TOOL_RESULT_CHARS=8000

# Timeouts (seconds unless noted). Defaults shown.
# SHELL_EXEC_TIMEOUT_SECONDS=30
# WEB_FETCH_TIMEOUT_SECONDS=30
# BROWSER_SUBPROCESS_TIMEOUT_SECONDS=60
# BROWSER_NAV_TIMEOUT_MS=30000
# SKILL_TIMEOUT_SECONDS=60

# Rate limiting on /chat, /chat/stream, /broadcast (HTTP + WebSocket).
# Sliding window, per platform:user_id, in-process only (resets on
# restart). Defaults shown.
# RATE_LIMIT_MAX_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60

# Dream Cycle — background reflection that reviews recent interactions and
# consolidates insights (inspired by OpenClaw's dream phase).
# DREAM_ENABLED=true
# DREAM_CRON=0 3 * * *
# DREAM_LOOKBACK_DAYS=3
# DREAM_AGENT_ID=kit

# Chat Platform Tokens (Phase 2)
# TELEGRAM_BOT_TOKEN=your-telegram-token
# DISCORD_BOT_TOKEN=your-discord-token

# Cloud LLM APIs (optional - for hybrid approach)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Web Search (Phase 4)
# WEB_SEARCH_PROVIDER selects the default search backend: tavily (default) or brave.
# The LLM can also override per-call via the "provider" parameter on web_search.
# WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-api-key-here   # Get from https://tavily.com
BRAVE_API_KEY=your-brave-api-key-here     # Get from https://brave.com/search/api/
